# Local MySQL credentials for docker-compose.yml. Change these for any shared environment.
MYSQL_DATABASE=staywise
MYSQL_USER=staywise_app
MYSQL_PASSWORD=change-me-local-only
MYSQL_ROOT_PASSWORD=change-me-root-local-only

# Backend connection (host-side Spring Boot process)
MYSQL_PORT=3307
DB_URL=jdbc:mysql://localhost:3307/staywise?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Kolkata
DB_USERNAME=staywise_app
DB_PASSWORD=change-me-local-only
